# Copy this file to .env (already gitignored) and fill in real values.
# scripts/remote-training.py and scripts/download-hf-model.py load it at
# startup (real env vars already set still win); never commit .env.

# Shared organizer dataset root (optional). Experiment git worktrees MUST point
# at the main checkout's data/ — never download a second copy.
# Prefer a junction/symlink named `data` in the worktree (relative target).
# Or set this to an absolute path resolved at runtime, e.g.:
#   WACV_DATA_ROOT="$(cd ../attribute-based-person-retrieval-core && pwd)/data"
# Overrides relative YAML `data.root` in load_config / download-dataset.py.
# WACV_DATA_ROOT=

# Hugging Face Hub (gated models, e.g. EmbeddingGemma / E94):
# https://huggingface.co/settings/tokens — create a read token, accept the
# model licence on the repo page, then set HF_TOKEN here.
# huggingface_hub also accepts HUGGING_FACE_HUB_TOKEN (same value); prefer
# HF_TOKEN. Interactive `hf auth login` / `huggingface-cli login` remains an
# optional fallback when neither env var is set.
HF_TOKEN=

# Kaggle: https://www.kaggle.com/settings -> Create New Token gives both.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Colab (google-colab-cli), for unattended use with no human present:
# one-time human setup: `gcloud auth application-default login
# --no-launch-browser`, then point this at a copy of the resulting file
# (~/.config/gcloud/application_default_credentials.json on Linux/macOS,
# %APPDATA%\gcloud\application_default_credentials.json on Windows).
# Use a personal Google account's own ADC file, not a service account -
# UNVERIFIED whether Colab's runtime quota accepts the latter.
GOOGLE_APPLICATION_CREDENTIALS=
