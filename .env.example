# Copy this file to .env (already gitignored) and fill in real values.
# scripts/remote-training.py loads it at startup; never commit .env.

# Shared organizer dataset root (optional). Experiment git worktrees MUST point
# at the main checkout's data/ — never download a second copy. Absolute path.
# Example (Windows): D:/competitions/.../attribute-based-person-retrieval-core/data
# Prefer a junction/symlink named `data` in the worktree when possible; this env
# overrides relative YAML `data.root` in load_config / download-dataset.py.
# WACV_DATA_ROOT=

# Kaggle: https://www.kaggle.com/settings -> Create New Token gives both.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Colab (google-colab-cli), for unattended use with no human present:
# one-time human setup: `gcloud auth application-default login
# --no-launch-browser`, then point this at a copy of the resulting file
# (~/.config/gcloud/application_default_credentials.json on Linux/macOS,
# %APPDATA%\gcloud\application_default_credentials.json on Windows).
# Use a personal Google account's own ADC file, not a service account -
# UNVERIFIED whether Colab's runtime quota accepts the latter.
GOOGLE_APPLICATION_CREDENTIALS=
